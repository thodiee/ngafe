<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files and sensitive directories
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Block access to sensitive extensions and config files
    <FilesMatch "\.(env|json|lock|xml|md|sql|log|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Redirect all traffic to the /public folder if document root is set to project root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
